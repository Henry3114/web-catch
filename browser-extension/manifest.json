{
  "manifest_version": 3,
  "name": "BOSS 职位导出 Excel",
  "version": "1.2.0",
  "description": "在已登录的 BOSS 职位搜索页逐条读取可见详情，保存为 Excel。遇到验证时暂停。",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_title": "按已保存的数量采集并导出Excel（右键→选项可设置）"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://*.zhipin.com/web/geek/jobs*"],
    "js": ["xlsx.js", "collector.js"],
    "run_at": "document_idle"
  }]
}
