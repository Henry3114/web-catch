{
  "manifest_version": 3,
  "name": "网页采集工作台 · 独立试用版",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "description": "自动识别职位列表和详情，按提示补充点选，批量采集并导出Excel。保留高级配置，独立于BOSS专用扩展。",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "打开网页采集工作台"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "studio.html"},
  "options_ui": {"page": "demo.html", "open_in_tab": true}
}
