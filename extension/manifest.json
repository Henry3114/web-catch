{
  "manifest_version": 3,
  "name": "网页采集工作台 · 独立试用版",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "鼠标点选列表及详情页字段，批量进入详情、翻页并导出Excel。独立于BOSS专用扩展。",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "打开网页采集工作台"},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "studio.html"},
  "options_ui": {"page": "demo.html", "open_in_tab": true}
}
